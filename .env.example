# ==============================================================================
# AERIX / APIx Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the active .env file containing real passwords or secrets to Git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Hosted Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Neon connection strings can be copied directly from your Neon Console dashboard.
# Async driver format (used by Scraper storage layer with asyncpg):
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-hostname>.neon.tech/<database>?sslmode=require

# Synchronous driver format (used by FastAPI backend with psycopg2):
DATABASE_URL_SYNC=postgresql://<user>:<password>@<neon-hostname>.neon.tech/<database>?sslmode=require

# Direct unpooled connection (optional, for migrations or administrative tasks):
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<neon-hostname>.neon.tech/<database>?sslmode=require

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND & CORS CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Port is injected automatically by Render ($PORT). Local default is 8000.
PORT=8000
ENVIRONMENT=production

# Comma-separated list of allowed frontend origins for CORS.
# In production on Render, set this to your Vercel deployment URL.
# Example: https://aerix-dashboard.vercel.app,https://aerix.vercel.app
FRONTEND_ORIGIN=https://your-aerix-frontend.vercel.app

# ------------------------------------------------------------------------------
# 3. CACHE & KEY-VALUE STORE (Optional - Render Redis / Upstash)
# ------------------------------------------------------------------------------
# If provisioned on Render or Upstash, provide the connection URI.
# If omitted or unset, the API will run gracefully with in-memory caching.
REDIS_URL=redis://red-<id>:6379

# ------------------------------------------------------------------------------
# 4. SCRAPER RUNTIME CONFIGURATION (Render Background Worker / Cron Job)
# ------------------------------------------------------------------------------
# Must be true in headless cloud container environments (e.g. Render/Linux)
SCRAPER_HEADLESS=true
SCRAPER_BROWSER_TYPE=chromium

# Rate limiting and policy controls
CRAWLER_CONCURRENCY=2
ROBOTS_TXT_COMPLIANCE=true

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE FOR EVIDENCE (Optional - S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=airfare-evidence
