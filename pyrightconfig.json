{
  "pythonVersion": "3.13",
  "venvPath": ".",
  "venv": ".venv",
  "pythonPlatform": "Windows",
  "extraPaths": [
    ".",
    "apps/scraper/src",
    "apps/api/src"
  ],
  "include": [
    "apps",
    "tests",
    "scripts"
  ],
  "exclude": [
    ".venv",
    "scratch",
    "node_modules",
    "**/__pycache__",
    "runtime",
    "storage"
  ],
  "reportMissingModuleSource": "none",
  "typeCheckingMode": "basic"
}
